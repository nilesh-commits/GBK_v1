# ---- Backend ----
# Elexon BMRS API base (no key required).
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Purchasing cutoff: provisional assumption (NOT an official market deadline).
# Resolved as <CUTOFF_LOCAL_TIME> in <CUTOFF_TIMEZONE> on the decision day.
CUTOFF_LOCAL_TIME=12:00
CUTOFF_TIMEZONE=Europe/London

# Origins allowed to call the API (JSON array). Set to the deployed frontend URL in prod.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Where the parquet cache lives (relative to the backend working dir).
DATA_DIR=data

# ---- Frontend (build-time) ----
VITE_API_URL=http://localhost:8000
